# Copy this file to .env and point these at your backend instances.
#
# On a physical device or emulator, "localhost" refers to the device itself,
# not your dev machine - use your machine's LAN IP instead (e.g. 192.168.1.23).

EXPO_PUBLIC_AUTH_API_URL=http://localhost:5038
EXPO_PUBLIC_MACHINE_API_URL=http://localhost:5135
